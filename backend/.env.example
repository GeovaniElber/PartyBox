PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=partybox

# Endereço do frontend (CORS, tempo real e links enviados por email)
CLIENT_URL=http://localhost:5173

JWT_SECRET=coloca_aqui_uma_chave_secreta_de_exemplo

# Regras de negócio
VALOR_MULTA_ATRASO=25
HORA_DEVOLUCAO=18:00
LISTA_ESPERA_PRAZO_HORAS=24

# Email (nodemailer). Sem estes valores, os emails são escritos na consola.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 e uma "palavra-passe de aplicação".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="PartyBox <nao-responder@partybox.pt>"

# WhatsApp Cloud API (Meta). Sem estes valores, as mensagens são escritas na consola.
# Mensagens iniciadas pela loja precisam de um modelo aprovado pela Meta com um parâmetro {{1}}.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_PT
